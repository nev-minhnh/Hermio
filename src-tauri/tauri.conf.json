{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermio",
  "mainBinaryName": "Hermio",
  "version": "0.7.5",
  "identifier": "app.hermio.mail",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Hermio",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' https: http: data: blob: cid:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost 'self' blob: data:",
        "media-src": "'self' data: blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'self' about: data: blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Hermio",
    "copyright": "© 2026 the Hermio contributors · MIT OR Apache-2.0",
    "homepage": "https://github.com/nev-minhnh/Hermio",
    "shortDescription": "Hermio – Automate your inbox flow",
    "longDescription": "Fast, good-looking email client with IMAP, POP3, Google Workspace and calendar sync.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
